{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-lanzamientos-lista",
      "urls": ["https://ll.thespacedevs.com/2.2.0/launch/upcoming/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 10,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "api-lanzamientos-detalle",
      "urls": ["https://ll.thespacedevs.com/2.2.0/launch/*/"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 50,
        "maxAge": "1d"
      }
    },
    {
      "name": "imagenes-lanzamientos",
      "urls": ["https://thespacedevs-prod.nyc3.digitaloceanspaces.com/**", "https://*.digitaloceanspaces.com/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 60,
        "maxAge": "7d"
      }
    }
  ]
}
